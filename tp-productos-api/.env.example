# Copiar este archivo como .env y reemplazar [YOUR-PASSWORD] por la contraseña real.
# El .env NO se sube a GitHub (esta en .gitignore).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Mercado Pago (credenciales de PRUEBA). Nunca va en el frontend.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
# Opcional: a donde vuelve el comprador despues de pagar. No puede ser localhost.
MP_BACK_URL=
