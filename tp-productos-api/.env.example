# Copiar este archivo como .env y reemplazar [YOUR-PASSWORD] por la contraseña real.
# El .env NO se sube a GitHub (esta en .gitignore).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Mercado Pago (credenciales de PRUEBA). Nunca va en el frontend.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
# Opcional: a donde vuelve el comprador despues de pagar. No puede ser localhost.
MP_BACK_URL=
# Opcional: URL pública del webhook (backend deployado + /api/v1/pagos/webhook). No puede ser localhost.
MP_WEBHOOK_URL=

# Gmail del proyecto, para los correos de pedidos. GMAIL_APP_PASSWORD es la "contraseña de aplicación"
# de 16 letras (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones), no la contraseña normal.
# Si quedan vacías, la API funciona igual pero no manda correos.
GMAIL_USER=promadera.ejemplo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
